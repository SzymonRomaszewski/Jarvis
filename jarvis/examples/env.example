# Copy to ~/.jarvis/env  (NOT into the project folder) and fill in what you have.
# One NAME=value per line. Lines starting with # are ignored. Variables already set in your shell win.

# --- Free brain: at least one of these (or use Ollama, see docs/privacy-and-security.md) ---
GROQ_API_KEY=gsk_your_key_here
# GEMINI_API_KEY=your_key_here          # free backup brain
# ANTHROPIC_API_KEY=sk-ant-...          # optional: Claude

# --- Optional extras ---
# BRAVE_API_KEY=...                     # better web search
# ELEVENLABS_API_KEY=...                # paid plan needed for Voice Library voices

# --- Things people commonly tune ---
# JARVIS_MIC_LEVEL=1700                 # how loud your speech must be (0 = automatic)
# JARVIS_SILENCE=0.9                    # seconds of silence that end your sentence
# JARVIS_PERSONALITY=classic            # classic | butler | friendly | sarcastic | minimal
# JARVIS_KOKORO_VOICE=bm_george         # bm_daniel | bm_lewis | bm_fable | bf_emma
# JARVIS_UNITS=uk                       # uk | metric | imperial
# JARVIS_FOLLOWUP=1                     # keep listening briefly after a reply
